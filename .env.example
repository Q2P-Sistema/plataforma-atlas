# =============================================================================
# Atlas — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores
# =============================================================================

# --- Banco de Dados (Postgres) ---
DATABASE_URL=postgresql://atlas:atlas_dev@localhost:5432/atlas_dev

# --- Cache (Redis) ---
REDIS_URL=redis://localhost:6379

# --- Sessão ---
SESSION_SECRET=troque-por-string-aleatoria-longa-em-producao

# --- Seed do Admin Inicial ---
SEED_ADMIN_EMAIL=admin@atlas.local
SEED_ADMIN_PASSWORD=TroqueEstaSenha123!

# --- n8n Health Check ---
# URL do health check do n8n (opcional em dev)
# N8N_HEALTH_URL=http://localhost:5678/healthz

# --- Sendgrid (e-mail transacional) ---
# Em dev, e-mails são logados no console em vez de enviados
# SENDGRID_API_KEY=SG.sua-chave-aqui
# SENDGRID_FROM_EMAIL=atlas@suaempresa.com.br
# Manda TODO e-mail para esta caixa, marcado com o ambiente (ACXEGDP-405).
# EMAIL_DESVIO_PARA=voce@acxe-polimeros.com.br

# --- Feature Flags de Módulos ---
# Habilite módulos conforme forem ficando prontos
MODULE_HEDGE_ENABLED=false
MODULE_STOCKBRIDGE_ENABLED=false
MODULE_BREAKINGPOINT_ENABLED=false
MODULE_CLEVEL_ENABLED=false
MODULE_COMEXINSIGHT_ENABLED=false
MODULE_COMEXFLOW_ENABLED=false
MODULE_FORECAST_ENABLED=false

# --- Server ---
API_PORT=3005
WEB_PORT=5173
NODE_ENV=development
# prod | uat | dev. Ausente = deduzido do NODE_ENV. 'uat' liga a faixa "ambiente de
# testes", exige OMIE_MODE=leitura|mock e não manda e-mail sem EMAIL_DESVIO_PARA.
# ATLAS_ENV=dev

# --- StockBridge — Integração OMIE (dual-CNPJ) ---
# Necessário quando MODULE_STOCKBRIDGE_ENABLED=true.
# OMIE_MODE: real | leitura | mock.
#   mock    — respostas sintéticas, sem rede (dev sem credenciais).
#   leitura — consulta o OMIE real e simula as escritas; as chaves vêm de
#             OMIE_LEITURA_{ACXE,Q2P}_{KEY,SECRET} (ACXEGDP-405 — é o modo do UAT).
# ATENÇÃO: leitura/mock + NODE_ENV=production só sobe com ATLAS_ENV=uat (STK-15).
OMIE_MODE=mock
OMIE_API_URL=https://app.omie.com.br/api/v1/
# OMIE_ACXE_KEY=
# OMIE_ACXE_SECRET=
# OMIE_Q2P_KEY=
# OMIE_Q2P_SECRET=

# Chave compartilhada entre n8n e Atlas para o endpoint de saídas automáticas
# ATLAS_INTEGRATION_KEY=troque-por-string-aleatoria-longa

# --- Autenticação ---
# Exigência global de 2FA (TOTP). Default: true (não setar = ligado).
# Setar false desativa o desafio de 2FA no login E o setup forçado de gestor/diretor
# — usar apenas em UAT/teste para agilizar. Em produção deve ficar true/ausente.
# AUTH_2FA_ENABLED=true

# --- StockBridge — MySQL Legado (apenas para migração one-shot) ---
# Usado somente pelo script `pnpm --filter @atlas/stockbridge migrate-from-mysql`.
# Não é necessário em operação normal do módulo.
# MYSQL_Q2P_HOST=database-01
# MYSQL_Q2P_PORT=3306
# MYSQL_Q2P_USER=claude_readonly
# MYSQL_Q2P_PASS=
# MYSQL_Q2P_DB=db_q2p

# ── StockBridge — feature 016 (ACXEGDP-395): recebimento fiscal da NF nacional pelo Atlas ──
# Liga a fonte "fiscal pendente" da fila (espelho tbl_recebimentoNFe_Q2P, escrito pelo n8n),
# a conclusao do recebimento fiscal no OMIE no clique do operador e a dispensa de NF pelo gestor.
# Default DESLIGADO: escreve em documento fiscal e muda o processo da equipe — ligar por ambiente, UAT primeiro.
STOCKBRIDGE_RECEBIMENTO_FISCAL_ENABLED=false
# Destinatarios do e-mail "NF dispensada da fila" ao fiscal (lista separada por virgula).
# Default: nfe@acxe-polimeros.com.br,mauricio@acxe-polimeros.com.br,gustavo.dreer@acxe-polimeros.com.br
# Em dev, aponte para a sua caixa para nao disparar ao fiscal real.
#STOCKBRIDGE_FISCAL_EMAILS=

# ── StockBridge — feature 017 (ACXEGDP-437): recebimento nacional com pedido de compra ──
# Com o fiscal feito pelo Atlas, NF com item sem pedido de compra (PC) possivel:
# true (padrao) = a NF e recusada (422 NF_SEM_PC) e fica na fila; false = o item e recebido sem vinculo.
STOCKBRIDGE_RECEBIMENTO_NACIONAL_EXIGE_PC=true
# Tolerancias da sugestao de PC (%): quantidade da NF acima do saldo do PC e diferenca de preco por kg.
STOCKBRIDGE_PC_TOLERANCIA_QTD_PCT=2
STOCKBRIDGE_PC_TOLERANCIA_PRECO_PCT=1
# Destinatarios do aviso "NF sem pedido de compra" (lista separada por virgula).
# Vazio = STOCKBRIDGE_OPS_EMAIL. Em dev, aponte para a sua caixa.
STOCKBRIDGE_COMPRAS_EMAILS=
# Idade maxima (min) da copia de PCs (tbl_pedidosCompras_*) antes do alerta e do modo seguro (503 COPIA_PCS_DEFASADA).
STOCKBRIDGE_COPIA_PCS_MAX_MIN=120
# PC em unidade diferente da NF (ex.: NF em toneladas, PC em kg): bloquear (padrao) = o PC nao e oferecido e a NF e
# recusada; converter = o Atlas manda a quantidade recebida ja na unidade do PC (ligar depois do teste com NF real).
STOCKBRIDGE_PC_UNIDADE_DIFERENTE=bloquear
# Baixa do PC pelo peso conferido (research D20 da 017): ligada, o peso da balanca acima da NF vai como quantidade
# recebida no recebimento fiscal, com teto no saldo do PC. Default false; ligar com o primeiro uso acompanhado.
STOCKBRIDGE_PC_BAIXA_PESO_CONFERIDO=false
# Excedente do peso conferido acima deste % da NF nao vai ao PC (provavel erro de digitacao).
STOCKBRIDGE_PC_PESO_CONFERIDO_MAX_PCT=10
# Fase 2 (Historia 5): NFs de compra nacional da ACXE na fila (fiscal e PC no OMIE da ACXE; entrada no local
# escolhido: o que tambem e da Q2P entra nas duas empresas, o so da ACXE entra so na ACXE). So vale com
# STOCKBRIDGE_RECEBIMENTO_FISCAL_ENABLED=true e com o corte proprio da ACXE (YYYY-MM-DD) abaixo.
STOCKBRIDGE_RECEBIMENTO_NACIONAL_ACXE_ENABLED=false
STOCKBRIDGE_RECEBIMENTO_NACIONAL_ACXE_DATA_CORTE=
