# =============================================================================
# Atlas — Variáveis de Ambiente de PRODUÇÃO (Portainer stack env)
# Copie para o campo "Environment variables" da stack `atlas` no Portainer e
# preencha. NÃO commitar a versão preenchida (segredos). Template apenas.
#
# Stack: deploy/portainer/atlas.stack.yml  →  host atlas.q2p.com.br
# Go-live: 2026-07-24. Estado operacional transplantado do UAT.
# =============================================================================

# --- Versão das imagens (tag fixa da release — rollback = trocar aqui) ---
ATLAS_VERSION=v1.1.9

# --- Banco de PRODUÇÃO (acxe_q2p, espelho OMIE vivo em public.*) ---
# Host INTERNO da rede do swarm que alcança o Postgres :5432 — o mesmo que a
# stack do n8n usa para gravar no espelho (confirmar no Portainer).
# Atlas grava seus schemas (atlas.*, stockbridge.*, shared.*, ...) NESTE banco.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST_INTERNO_SWARM:5432/acxe_q2p

# --- Redis da stack (serviço `redis` da própria stack `atlas`) ---
REDIS_URL=redis://atlas_redis:6379

# --- Sessão (>=16 chars; gere NOVO — não reuse o do UAT: `openssl rand -base64 48`) ---
SESSION_SECRET=GERE_UMA_STRING_ALEATORIA_LONGA_NOVA

# --- SEED_ADMIN_* : NÃO definir em produção ---
# atlas.users chega populada da UAT (transplante do cutover); o seed só rodaria
# com a tabela vazia e a ausência evita mascarar uma cópia falha.

# --- n8n health (URL pública) ---
N8N_HEALTH_URL=https://conector.q2p.com.br/healthz

# --- Frontend (CORS + links dos e-mails) ---
APP_URL=https://atlas.q2p.com.br

# --- E-mail (SendGrid — mesmos valores do UAT) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=sistema@q2p.com.br

# --- OMIE (dual-CNPJ — mesmas credenciais do UAT; o ERP é o mesmo) ---
# PRODUÇÃO: obrigatoriamente `real`. `mock` + NODE_ENV=production DERRUBA o
# boot (guard STK-15) — o smoke test do go-live é só-leitura, sem fase mock.
OMIE_MODE=real
OMIE_API_URL=https://app.omie.com.br/api/v1/
OMIE_ACXE_KEY=
OMIE_ACXE_SECRET=
OMIE_Q2P_KEY=
OMIE_Q2P_SECRET=

# --- StockBridge ---
# IMPORTANTE: deixe COMENTADAS se não usar. String vazia (=) quebra o boot —
# o Zod valida email/data e "" não conta como ausente. Descomente só com valor
# válido (replicar o que o UAT usa hoje).
# STOCKBRIDGE_ADMIN_CC_EMAIL=admin@acxe-polimeros.com.br
# STOCKBRIDGE_FISCAL_CUTOFF_DATE=2026-01-01
# Shared secret n8n ↔ Atlas (>=16 chars) — REUSAR o valor do UAT: a instância
# n8n tem UMA env ATLAS_INTEGRATION_KEY; reusar evita trocar credencial do
# n8n na janela do cutover.
ATLAS_INTEGRATION_KEY=MESMO_VALOR_DO_UAT

# --- Feature flags (go-live: 4 módulos validados no ensaio UAT) ---
MODULE_STOCKBRIDGE_ENABLED=true
MODULE_FORECAST_ENABLED=true
MODULE_HEDGE_ENABLED=true
MODULE_BREAKINGPOINT_ENABLED=true
MODULE_CLEVEL_ENABLED=false
MODULE_COMEXINSIGHT_ENABLED=false
MODULE_COMEXFLOW_ENABLED=false

# --- Autenticação ---
# 2FA LIGADO em produção (com ACXEGDP-316, é barreira real no backend para
# gestor/diretor). Diferente do UAT, que roda com false.
AUTH_2FA_ENABLED=true
