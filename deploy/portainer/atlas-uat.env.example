# =============================================================================
# Atlas — Variáveis de Ambiente do UAT (Portainer stack env)
# Copie para o campo "Environment variables" da stack no Portainer e preencha.
# NÃO commitar a versão preenchida (segredos). Este arquivo é só o template.
#
# Stack: uat-atlas - web e api.yaml  →  host uat-atlas.q2p.com.br
# =============================================================================

# --- Banco UAT (acxe_q2p no servidor UAT) ---
# Mesmo Postgres que tem o espelho OMIE em public.* (db.manager01.q2p.com.br:5437).
# Atlas grava seus schemas (stockbridge.*, shared.*, ...) NESTE banco.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST_INTERNO_SWARM:5437/acxe_q2p

# --- Redis UAT ---
REDIS_URL=redis://HOST_REDIS_UAT:6379

# --- Sessão (>=16 chars; gere um novo, NÃO reuse o de prod) ---
SESSION_SECRET=GERE_UMA_STRING_ALEATORIA_LONGA

# --- Seed do admin inicial (só roda se a tabela users estiver vazia) ---
SEED_ADMIN_EMAIL=flavio.endo@acxe-polimeros.com.br
SEED_ADMIN_PASSWORD=TroqueEstaSenhaNoPrimeiroLogin

# --- n8n health ---
N8N_HEALTH_URL=http://n8n_editor_n8n_editor:5678/healthz

# --- Frontend UAT (links dos e-mails) ---
APP_URL=https://uat-atlas.q2p.com.br

# --- E-mail (SendGrid) ---
# Sem chave => e-mails só em log. Para ensaio fiel, preencher.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=sistema@q2p.com.br

# --- OMIE (dual-CNPJ) ---
# ⚠️ OMIE_MODE=real GRAVA no ERP OMIE de verdade (ACXE + Q2P).
#    Suba como 'mock' para o smoke test; flipe para 'real' quando pronto.
OMIE_MODE=mock
OMIE_API_URL=https://app.omie.com.br/api/v1/
OMIE_ACXE_KEY=
OMIE_ACXE_SECRET=
OMIE_Q2P_KEY=
OMIE_Q2P_SECRET=

# --- StockBridge ---
STOCKBRIDGE_ADMIN_CC_EMAIL=
# Data de corte do gap fiscal/físico no Cockpit (YYYY-MM-DD). Sem set: 180d atrás.
STOCKBRIDGE_FISCAL_CUTOFF_DATE=
# Shared secret n8n ↔ Atlas para saídas automáticas (>=16 chars).
ATLAS_INTEGRATION_KEY=GERE_UMA_STRING_ALEATORIA_LONGA

# --- Feature flags (escopo deste UAT) ---
MODULE_STOCKBRIDGE_ENABLED=true
MODULE_FORECAST_ENABLED=true
MODULE_HEDGE_ENABLED=true
MODULE_BREAKINGPOINT_ENABLED=true
MODULE_CLEVEL_ENABLED=false
MODULE_COMEXINSIGHT_ENABLED=false
MODULE_COMEXFLOW_ENABLED=false
